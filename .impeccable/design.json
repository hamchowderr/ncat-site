  "narrative": {
    "northStar": "The Category Standard",
    "overview": "The site deliberately looks like the clipping platforms its buyers already know: a white page, one violet accent, a centred sentence-case headline, an ask bar with example chips, and a large stage showing the real product. Familiarity is the point. A creator or agency should recognise the category in one glance, then notice the difference in the words: pay once, own it, it runs by itself.\n\nEverything sits on white or on soft grey panels. Groups are made with space and tone, never with heavy outlines. The product does the visual work: real screen recordings in the hero and real dashboard screens through the page, each set on a soft grey panel like a photo on a mat. Motion is small and purposeful: one rotating word in the headline, tabs that swap recordings, and nothing that moves for people who turn motion off.",
    "keyCharacteristics": [
      "White ground, one violet accent, soft grey panels",
      "Pill shapes for every control: buttons, ask bar, tabs, chips, form choices",
      "Real product media on grey mats, with a soft lifted shadow on the screen itself",
      "Archivo display with tight tracking over Geist body",
      "Space and tone for grouping, hairlines only on chips and unselected pills"
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Violet is the only hue. It marks actions and the product's own side of any comparison; it never decorates.",
        "section": "colors"
      },
      {
        "name": "The One Wash Rule",
        "body": "At most one Violet Wash panel per view, so the highlighted choice stays obvious.",
        "section": "colors"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Every heading is sentence case. No kickers or eyebrow labels above headings.",
        "section": "typography"
      },
      {
        "name": "The No Heavy Lines Rule",
        "body": "Group with space and soft tones. Outlines are at most a 1px inset Hairline on small controls; containers never get borders.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show the real product: recordings and screenshots of the working dashboard, with demo data said plainly.",
      "Do use the real logo of every company or platform named.",
      "Do keep violet for actions and for the product's own side of a comparison.",
      "Do put product media on Mat Grey with the screen lift shadow.",
      "Do keep every control a pill."
    ],
    "donts": [
      "Don't draw borders around containers or use heavy box outlines.",
      "Don't let anything overlay content: no floating bars or sticky overlays over text.",
      "Don't add kickers or eyebrow labels above headings.",
      "Don't use sparkle or star icons for AI.",
