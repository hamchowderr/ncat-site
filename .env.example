# Public address of the site, used for share links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# Early-access form. Sign-ups are emailed through toSend (tosend.com).
TOSEND_API_KEY=
# An address on a domain verified in toSend, e.g. dashboard@otakusolutions.io
EARLY_ACCESS_FROM=
# Where sign-ups are sent.
EARLY_ACCESS_TO=

# Sends each beta sign-up to the Takewon app's Admin page Beta Testers, server to server.
# TAKEWON_BETA_URL is the app's <Convex HTTP address>/beta/apply; BETA_SIGNUP_SECRET must
# match the app's. Unset: sign-ups are only kept in Blob and emailed.
TAKEWON_BETA_URL=
BETA_SIGNUP_SECRET=

# Keeps a copy of every sign-up as a private file (leads/YYYY-MM-DD/...). Vercel sets this
# when a Blob store is connected to the project. Without it, sign-ups are only emailed.
BLOB_READ_WRITE_TOKEN=

# The hosted dashboard's sign-up page, for the "Start your 3-day free trial" buttons.
# Unset: the buttons lead to early access instead. Must start with https://
NEXT_PUBLIC_TRIAL_URL=

# The homepage demo runs visitors' videos through a real NCA Toolkit after they sign up.
# Both must be set (with BLOB_READ_WRITE_TOKEN) or the demo section is left off the page.
NCAT_API_URL=https://media.otakusolutions.io
NCAT_API_KEY=
# Runs per day across all visitors (default 40). Each email gets one run.
DEMO_DAILY_LIMIT=
# Optional: signs the private links to each run. Defaults to one made from the Blob token.
DEMO_SECRET=
# Vercel sends this to the daily clean-up that deletes uploads after 7 days.
CRON_SECRET=
